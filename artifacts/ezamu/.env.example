# Required: Clerk frontend publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Clerk Frontend API proxy path. Use this when your API serves /api/__clerk.
# For same-domain Vercel + API rewrite setups, /api/__clerk is usually correct.
VITE_CLERK_PROXY_URL=/api/__clerk

# Optional: Set only if your API is on a different domain and you are not proxying /api via Vercel.
# Example: https://your-api.up.railway.app
# VITE_API_BASE_URL=
